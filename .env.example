# =============================================================================
# Variables d'environnement — Peak Clipping Agency
# Copiez ce fichier en `.env.local` (développement) ou saisissez ces valeurs
# dans Vercel → Project → Settings → Environment Variables (production).
# Ne commitez JAMAIS un fichier contenant de vraies clés.
# En local, `npm run supabase:start` écrit .env.local automatiquement.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Adresse publique du site (sans / final). Local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données + comptes) --------------------------------------
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Supabase → Project Settings → API Keys → « Publishable key » (sb_publishable_…)
# Clé publique : elle peut être vue par le navigateur, la sécurité vient de la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Supabase → Project Settings → API Keys → « Secret key » (sb_secret_…)
# SECRÈTE : contourne toutes les règles d'accès. Uniquement côté serveur / Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- E-mails (Resend) ------------------------------------------------------------
# Resend → API Keys → Create API key. SECRÈTE. Sans clé, aucun e-mail n'est envoyé :
# ils sont seulement écrits dans le journal du serveur (pratique en local).
RESEND_API_KEY=
# Expéditeur des e-mails : une adresse de votre domaine vérifié dans Resend.
EMAIL_FROM=Peak Clipping Agency <no-reply@votre-domaine.fr>

# --- Tâches planifiées (Vercel Cron) ---------------------------------------------
# Texte secret long et aléatoire (ex. généré par un gestionnaire de mots de passe).
# Vercel l'envoie automatiquement à la tâche quotidienne des abonnements.
CRON_SECRET=

# --- Données de démonstration (npm run seed) -----------------------------------
# Mot de passe commun des comptes de démo (facultatif, défaut : Peak-Demo-2026!)
# DEMO_PASSWORD=

# --- Tests ----------------------------------------------------------------------
# Base Postgres utilisée par les tests RLS (npm run test:db). Défaut : Supabase local.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Multiplie les limites anti-abus (connexion, inscription) pendant les tests automatisés.
# RATE_LIMIT_FACTOR=1
